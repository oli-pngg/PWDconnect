# Browser-safe Supabase values. Never put the service-role key in these fields.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-limited-publishable-key

# Server-only. Keep this out of client code, Docker build args, and source control.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
ASSESSMENT_SESSION_SECRET=use-a-long-random-server-only-value

NEXT_PUBLIC_SITE_URL=http://localhost:3000
