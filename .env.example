# Supabase project settings. The browser-visible values must be the limited
# publishable/anon key, never the service-role key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-limited-publishable-key

# Server-only. Never prefix this with NEXT_PUBLIC_ and never expose it to a client component.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional URL used in email links. Set this to the deployed site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
